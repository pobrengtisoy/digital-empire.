{
  "name": "digital-empire",
  "compatibility_date": "2026-11-11",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Database for real shops (orders, menus, owner accounts). Wrangler creates it on first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "rz-empire" }
  ]
}
