{
  "name": "digital-empire",
  "compatibility_date": "2026-11-11",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Lets Cloudflare build preview links for non-production branches (`wrangler preview`).
  "previews": {},
  // Database for real shops (orders, menus, owner accounts). Created in the Cloudflare dashboard.
  "d1_databases": [
    { "binding": "DB", "database_name": "rz-empire", "database_id": "af0b0365-7ba0-47c3-a41b-d8f8f47c28e3" }
  ]
}
