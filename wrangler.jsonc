{
  "name": "digital-empire",
  "compatibility_date": "2026-11-11",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Lets Cloudflare build preview links for non-production branches (`wrangler preview`).
  // Previews use their own database so test orders never touch live data.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "rz-empire-preview", "database_id": "11f8b4d3-e31f-45ff-821c-b8249d40ff7f" }
    ],
    "r2_buckets": [
      { "binding": "PHOTOS", "bucket_name": "rz-photos-preview" }
    ]
  },
  // Database for real shops (orders, menus, owner accounts). Created in the Cloudflare dashboard.
  "d1_databases": [
    { "binding": "DB", "database_name": "rz-empire", "database_id": "af0b0365-7ba0-47c3-a41b-d8f8f47c28e3" }
  ],
  // Listing photos for RZ Bahay. Created in the Cloudflare dashboard (R2, free tier).
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "rz-photos" }
  ]
}
